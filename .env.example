# === Server ===
NODE_ENV=production
PORT=3000

# === Database (MySQL) ===
DATABASE_URL=mysql://user:password@host:3306/dashboard_multipark

# === Auth (Google OAuth) ===
JWT_SECRET=your-secret-key-here-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_APP_ID=dashboard-multipark
OWNER_OPEN_ID=google_123456789
# Duração da sessão em dias (default 30).
# SESSION_MAX_DAYS=30
# Modo FECHADO: só entra quem já tenha conta criada pelo backoffice (por email).
# Sem esta env, qualquer conta Google entra e fica com role `user` (sem
# permissões relevantes). Contas desativadas são SEMPRE recusadas, com ou sem
# esta env. Mensagem única de recusa: ACCESS_DENIED_MSG (shared/const.ts).
# RESTRICT_LOGIN_TO_REGISTERED=true

# === Storage (Vercel Blob) ===
# OBRIGATÓRIO em produção: sem este token o storagePut recusa uploads no
# Vercel (e em dev grava em ./uploads com URLs relativas que só o server
# local serve). Obter em: Vercel dashboard → Storage → Blob.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# (As envs AWS_* antigas eram do S3 e estão MORTAS — o código não as lê.)

# === LLM / OpenAI (OCR, AI responses, transcription) ===
LLM_API_URL=https://api.openai.com
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@multipark.pt
OWNER_EMAIL=jorge@example.com

# === Email INBOUND (IMAP — leitor de reclamações/perdidos/críticas/RH) ===
# Caixa reservas@multipark.pt; gera uma App Password do Google (com 2FA) e ativa IMAP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=reservas@multipark.pt
IMAP_PASS=your-google-app-password
IMAP_SINCE_DAYS=30

# === MultiPark API ===
MULTIPARK_API_KEY=your-multipark-key
MULTIPARK_API_URL=https://api.multipark.pt/api/v1/bookings-api

# === Zello Work (GPS, Radio) ===
ZELLO_API_KEY=your-zello-api-key
ZELLO_USERNAME=admin
ZELLO_PASSWORD=your-zello-password
ZELLO_NETWORK=airpark

# === Google Maps (optional) ===
GOOGLE_MAPS_API_KEY=your-google-maps-key
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-key

# === WhatsApp Cloud API (Meta Graph API) ===
# Envio em massa de templates aos extras + inbox de respostas via webhook.
# WHATSAPP_TOKEN: token de acesso da app Meta (System User token de longa duração).
# WHATSAPP_PHONE_NUMBER_ID: id do número de WhatsApp Business (não é o número em si).
# WHATSAPP_VERIFY_TOKEN: string à tua escolha; tem de bater certo com a config do webhook na Meta.
# WHATSAPP_APP_SECRET: App Secret da app Meta — valida a assinatura X-Hub-Signature-256 dos webhooks.
# WHATSAPP_API_VERSION: versão da Graph API (default v21.0 no código se omitido).
WHATSAPP_TOKEN=your-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Webhook das Conexões Multipark (reservas em tempo real) ──────────────────
# Chave que se cola na config das Conexões (multipark.app) para as 3 operações
# (criação/atualização/cancelamento), apontadas a POST /api/multipark/webhook.
# Valida o Bearer e a assinatura HMAC X-Multipark-Signature. ≥32 chars random.
MULTIPARK_WEBHOOK_SECRET=choose-a-long-random-secret
WHATSAPP_API_VERSION=v21.0

# === Formulário externo de disponibilidades (Fase 4) ===
# AVAILABILITY_FORM_TOKEN_SECRET: segredo DEDICADO (min 32 chars) para assinar os
#   tokens JWT single-use do formulário. NÃO reutilizar o JWT_SECRET de sessão —
#   assim pode ser rodado independentemente.
# AVAILABILITY_FORM_URL (opcional): URL base da app externa; usado para construir
#   o link {AVAILABILITY_FORM_URL}?token=... (o botão do template no WhatsApp
#   Manager deve apontar para esta base com {{1}} = token).
AVAILABILITY_FORM_TOKEN_SECRET=another-secret-min-32-chars-distinct-from-jwt
AVAILABILITY_FORM_URL=https://disponibilidade.multipark.pt
