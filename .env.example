# === Server ===
NODE_ENV=production
PORT=3000

# === Database (MySQL) ===
DATABASE_URL=mysql://user:password@host:3306/dashboard_multipark

# === Google Ads (integração de LEITURA — ver memory/google-ads-integration.md) ===
# Projeto Google Cloud PRÓPRIO (não reutilizar o cliente do login). Cliente OAuth
# "Web application" com redirect URI EXATAMENTE:
#   https://dashboard.multipark.pt/api/integrations/google-ads/oauth/callback
# GOOGLE_ADS_CLIENT_ID=xxxx.apps.googleusercontent.com
# GOOGLE_ADS_CLIENT_SECRET=
# O projeto Cloud precisa de acesso Explorer/Basic/Standard para contas reais.
# Desde 2026-09-09, o Google já não exige developer token.
# Conta gestora (MCC) usada no acesso, só dígitos. Opcional se a conta autorizada acede diretamente.
# GOOGLE_ADS_LOGIN_CUSTOMER_ID=1234567890
# Só é preciso se o domínio público for diferente do host do pedido.
# GOOGLE_ADS_REDIRECT_URI=https://dashboard.multipark.pt/api/integrations/google-ads/oauth/callback
# Versão da API (default v25; v21 foi desativada pela Google).
# GOOGLE_ADS_API_VERSION=v25
# ── Meta Ads (Facebook/Instagram) — dormente até estas duas estarem definidas ──
# Token de longa duração de um utilizador de sistema (Business Manager) com ads_read.
# META_ACCESS_TOKEN=
# Contas de anúncios, separadas por vírgula (com ou sem "act_").
# META_AD_ACCOUNT_IDS=act_123456789,act_987654321
# Versão da Graph API (default v24.0).
# META_API_VERSION=v24.0
# ── Email semanal de marketing (segunda ≥ 8h Lisboa; precisa do SMTP abaixo) ──
# MARKETING_REPORT_EMAILS=jorge@multipark.pt,marketing@multipark.pt
# MARKETING_WEEKLY=off   # desliga o email semanal
# Chave de cifra dos segredos guardados em BD (refresh token): `openssl rand -base64 32`.
# Sem esta env deriva-se do JWT_SECRET (funciona, mas mudar o JWT_SECRET invalida o token).
# INTEGRATIONS_ENCRYPTION_KEY=
# Segredo dos crons (GitHub Actions → /api/cron/*). O cron Google Ads recusa pedidos sem este segredo.
# CRON_SECRET=

# === Auth (Google OAuth) ===
JWT_SECRET=your-secret-key-here-min-32-chars
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
VITE_APP_ID=dashboard-multipark
OWNER_OPEN_ID=google_123456789
# Duração da sessão em dias (default 30).
# SESSION_MAX_DAYS=30
# Modo FECHADO: só entra quem já tenha conta criada pelo backoffice (por email).
# Sem esta env, qualquer conta Google entra e fica com role `user` (sem
# permissões relevantes). Contas desativadas são SEMPRE recusadas, com ou sem
# esta env. Mensagem única de recusa: ACCESS_DENIED_MSG (shared/const.ts).
# RESTRICT_LOGIN_TO_REGISTERED=true

# === Storage ===
# Precedência em server/storage.ts: S3 (as 4 envs AWS_* abaixo) → Vercel Blob
# (BLOB_READ_WRITE_TOKEN) → filesystem local ./uploads (só em dev; no Vercel
# falha alto). Sem as envs AWS_* nada muda face ao que já existia.
#
# ── S3 (AWS) — bucket dedicado a vídeos, documentos e fotos ──────────────────
# As CREDENCIAIS levam prefixo AWS_S3_ porque o Vercel RESERVA os nomes
# AWS_ACCESS_KEY / AWS_SECRET_ACCESS_KEY. O código continua a aceitar os nomes
# antigos como fallback (as apps `multipark`/`be-multipark` mantêm-nos).
# Objetos públicos à leitura (GET não assinado); o utilizador IAM do upload só
# tem s3:PutObject/GetObject/DeleteObject em <bucket>/* — NÃO consegue listar.
# S3_PUBLIC_BASE_URL é OPCIONAL: sem ela deriva-se
# https://<AWS_S3_BUCKET_NAME>.s3.<AWS_S3_REGION>.amazonaws.com
# (define-a só se houver CloudFront/domínio próprio à frente do bucket).
# O CORS do bucket tem de permitir GET/HEAD/PUT às origens da app — o PUT é
# necessário para o upload direto do browser (storagePresignPut), a única via
# para ficheiros grandes (o body das funções do Vercel está limitado a ~4.5MB).
AWS_S3_REGION=eu-west-1
AWS_S3_BUCKET_NAME=dashboard-multipark-bucket
AWS_S3_ACCESS_KEY=AKIA...
AWS_S3_SECRET_ACCESS_KEY=your-iam-user-secret
# S3_PUBLIC_BASE_URL=https://dashboard-multipark-bucket.s3.eu-west-1.amazonaws.com
#
# ── Vercel Blob (fallback / storage anterior) ────────────────────────────────
# Usado quando as envs AWS_* NÃO estão definidas. Sem este token e sem S3, o
# storagePut recusa uploads no Vercel (e em dev grava em ./uploads com URLs
# relativas que só o server local serve). Obter em: Vercel dashboard → Storage → Blob.
# ATENÇÃO: mudar de backend não migra os ficheiros já gravados — as URLs
# antigas do Blob continuam a funcionar porque ficam guardadas na BD.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# === LLM / OpenAI (OCR, AI responses, transcription) ===
LLM_API_URL=https://api.openai.com
LLM_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# === Email (SMTP) ===
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@multipark.pt
OWNER_EMAIL=jorge@example.com

# === Email INBOUND (IMAP — leitor de reclamações/perdidos/críticas/RH) ===
# Caixa reservas@multipark.pt; gera uma App Password do Google (com 2FA) e ativa IMAP.
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=reservas@multipark.pt
IMAP_PASS=your-google-app-password
IMAP_SINCE_DAYS=30

# === MultiPark API ===
MULTIPARK_API_KEY=your-multipark-key
MULTIPARK_API_URL=https://api.multipark.pt/api/v1/bookings-api

# === Zello Work (GPS, Radio) ===
ZELLO_API_KEY=your-zello-api-key
ZELLO_USERNAME=admin
ZELLO_PASSWORD=your-zello-password
ZELLO_NETWORK=airpark

# === WhatsApp Cloud API (Meta Graph API) ===
# Envio em massa de templates aos extras + inbox de respostas via webhook.
# WHATSAPP_TOKEN: token de acesso da app Meta (System User token de longa duração).
# WHATSAPP_PHONE_NUMBER_ID: id do número de WhatsApp Business (não é o número em si).
# WHATSAPP_VERIFY_TOKEN: string à tua escolha; tem de bater certo com a config do webhook na Meta.
# WHATSAPP_APP_SECRET: App Secret da app Meta — valida a assinatura X-Hub-Signature-256 dos webhooks.
# WHATSAPP_API_VERSION: versão da Graph API (omitido = a mesma do Meta Ads, v24.0).
# WHATSAPP_WABA_ID: id da conta WhatsApp Business. OPCIONAL mas RECOMENDADO — é com
#   ele que o envio inspeciona o template antes de enviar (parâmetros nomeados vs
#   posicionais, quantos são, se há botão com link) e adapta o payload. Sem ele, o
#   código tenta descobri-lo pelo token (/debug_token); se o token der acesso a mais
#   do que uma conta, a inspeção é desligada e o envio segue às cegas.
WHATSAPP_TOKEN=your-meta-system-user-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=choose-a-random-verify-token
WHATSAPP_APP_SECRET=your-meta-app-secret

# ── Webhook das Conexões Multipark (reservas em tempo real) ──────────────────
# Chave que se cola na config das Conexões (multipark.app) para as 3 operações
# (criação/atualização/cancelamento), apontadas a POST /api/multipark/webhook.
# Valida o Bearer e a assinatura HMAC X-Multipark-Signature. ≥32 chars random.
MULTIPARK_WEBHOOK_SECRET=choose-a-long-random-secret
# WHATSAPP_API_VERSION=v24.0
WHATSAPP_WABA_ID=your-whatsapp-business-account-id

# === Formulário externo de disponibilidades (Fase 4) ===
# AVAILABILITY_FORM_TOKEN_SECRET: segredo DEDICADO (min 32 chars) para assinar os
#   tokens JWT single-use do formulário. NÃO reutilizar o JWT_SECRET de sessão —
#   assim pode ser rodado independentemente.
# AVAILABILITY_FORM_URL (opcional): URL base da app externa; usado para construir
#   o link {AVAILABILITY_FORM_URL}?token=... (o botão do template no WhatsApp
#   Manager deve apontar para esta base com {{1}} = token).
AVAILABILITY_FORM_TOKEN_SECRET=another-secret-min-32-chars-distinct-from-jwt
AVAILABILITY_FORM_URL=https://multidriver.pt/availability

# === Leads de extras (funil de recrutamento) ===
# DRIVER_APPLICATION_URL (opcional): link da candidatura "Be a Driver" enviado na
#   resposta automática a um lead que responde por WhatsApp. SEM esta variável
#   não há resposta automática (não se envia um link adivinhado).
# LEAD_AUTO_REPLY=off desliga essa resposta automática (sai no máximo 1× por lead).
# LEAD_REMINDERS=off desliga o lembrete automático (reenvio do seja_motorista aos
#   contactados sem resposta há >3 dias, seg–sáb 10h–19h, máx. 2 envios por lead).
# DRIVER_APPLICATION_URL=https://multidriver.pt
# LEAD_AUTO_REPLY=off
# LEAD_REMINDERS=off
# Google Business Profile: reutiliza o cliente OAuth Google Ads por defeito.
# Registar também: https://dashboard.multipark.pt/api/integrations/google-business/oauth/callback
# GOOGLE_BUSINESS_CLIENT_ID=
# GOOGLE_BUSINESS_CLIENT_SECRET=
# GOOGLE_BUSINESS_ORIGIN=https://dashboard.multipark.pt
# Push Pub/Sub: só aceita tokens Google desta identidade, audiência e subscrição.
# GOOGLE_BUSINESS_PUSH_AUDIENCE=https://dashboard.multipark.pt/api/integrations/google-business/webhook
# GOOGLE_BUSINESS_PUSH_EMAIL=
# GOOGLE_BUSINESS_SUBSCRIPTION=projects/PROJECT/subscriptions/SUBSCRIPTION

# Tarefas: responsável das tarefas "Disponibilidade a confirmar" (email da ficha
# ou da conta). Sem valor → kamilafagundes@multipark.pt.
# AVAILABILITY_TASK_ASSIGNEE_EMAIL=
# TASKS_AUTOMATION=off desliga checklists recorrentes + avisos de atraso/conclusão.
# TASKS_AUTOMATION=

# === URLs públicas da app ===
# Base usada em links de emails/WhatsApp (APP_URL tem precedência sobre PUBLIC_APP_URL).
# APP_URL=https://dashbord-multipark.vercel.app
# PUBLIC_APP_URL=https://dashbord-multipark.vercel.app

# === LLM (aliases aceites) ===
# OPENAI_API_URL / OPENAI_API_KEY são alternativas a LLM_API_URL / LLM_API_KEY.
# OPENAI_API_URL=
# OPENAI_API_KEY=

# === Diversos ===
# Login de desenvolvimento (só fora de produção); sem valor fica desativado.
# DEV_LOGIN_TOKEN=
# OAUTH_SERVER_URL=

# === Operação / crons ===
# Fuso das operações (escala dos extras). Default Europe/Lisbon.
# OPERATION_TZ=Europe/Lisbon
# Orçamento (ms) de cada chamada de cron — tem de caber nos 60s do Vercel. Default 50000.
# CRON_BUDGET_MS=50000
# Timeout (ms) de cada pedido à API Multipark. Default 15000.
# MULTIPARK_FETCH_TIMEOUT_MS=15000
# SLA (horas) das ocorrências. Default 48.
# INCIDENT_SLA_HOURS=48
# AGENDADOR: o oficial é o GitHub Actions (.github/workflows/*.yml → /api/cron/*).
# Os timers in-process do servidor Node (sync de reservas 15 min, emails 15 min,
# recolha Zello 02:00) estão DESLIGADOS por omissão em todo o lado (no Vercel
# nunca ligam). Só pôr "on" num servidor persistente (ex.: Railway) que NÃO
# esteja também a ser servido pelos crons — senão os jobs correm a dobrar.
# INPROCESS_SCHEDULERS=off

# === Kill-switches das automações ===
# Todos ligados por omissão. Desligam com off / false / 0 / no (qualquer caixa).
# EXTRAS_AUTOMATION=
# TASKS_AUTOMATION=
# CASE_REMINDERS=
# COMPLAINT_AUTO_ACK=
# HANDOVER_REMINDERS=
# HANDOVER_EMAIL=
# HANDOVER_EMAIL_CC=
# TRAINING_REMINDERS=
# TRAINING_BLOCKS_ESCALA=
# LEAD_REMINDERS=
# LEAD_AUTO_REPLY=

# === Chaves da API Multipark por parque ===
# Uma por parque (server/multipark.ts → PARK_CONFIGS). Sem chave, o parque fica
# "por configurar" e as reservas dele não são sincronizadas.
# MULTIPARK_API_KEY_FARO_AIRPARK=
# MULTIPARK_API_KEY_FARO_BOARDINGPARK=
# MULTIPARK_API_KEY_FARO_PARKDIRECT=
# MULTIPARK_API_KEY_FARO_PREMIUM_PARK=
# MULTIPARK_API_KEY_FARO_READYPARK=
# MULTIPARK_API_KEY_FARO_REDPARK=
# MULTIPARK_API_KEY_FARO_SKYPARK=
# MULTIPARK_API_KEY_FARO_STOP_FLY_PARK=
# MULTIPARK_API_KEY_FARO_TRAVELPARKING=
# MULTIPARK_API_KEY_FARO_VIAGENSPARKING=
# MULTIPARK_API_KEY_LISBON_AIRPARK=
# MULTIPARK_API_KEY_LISBON_BOARDINGPARK=
# MULTIPARK_API_KEY_LISBON_PARKDIRECT=
# MULTIPARK_API_KEY_LISBON_PREMIUM_PARK=
# MULTIPARK_API_KEY_LISBON_READYPARK=
# MULTIPARK_API_KEY_LISBON_REDPARK=
# MULTIPARK_API_KEY_LISBON_SKYPARK=
# MULTIPARK_API_KEY_LISBON_STOP_FLY_PARK=
# MULTIPARK_API_KEY_LISBON_TOP_PARKING=
# MULTIPARK_API_KEY_LISBON_TRAVELPARKING=
# MULTIPARK_API_KEY_LISBON_VIAGENSPARKING=
# MULTIPARK_API_KEY_PORTO_AIRPARK=
# MULTIPARK_API_KEY_PORTO_BOARDINGPARK=
# MULTIPARK_API_KEY_PORTO_PARKDIRECT=
# MULTIPARK_API_KEY_PORTO_PREMIUM_PARK=
# MULTIPARK_API_KEY_PORTO_READYPARK=
# MULTIPARK_API_KEY_PORTO_REDPARK=
# MULTIPARK_API_KEY_PORTO_SKYPARK=
# MULTIPARK_API_KEY_PORTO_STOP_FLY_PARK=
# MULTIPARK_API_KEY_PORTO_TOP_PARKING=
# MULTIPARK_API_KEY_PORTO_TRAVELPARKING=
# MULTIPARK_API_KEY_PORTO_VIAGENSPARKING=
